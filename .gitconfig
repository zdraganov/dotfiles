[user]
        name = Zhivko Draganov
        email = zhivko.draganov@gmail.com
# Work repos get the work e-mail (same GitHub account, different verified address).
[includeIf "gitdir:~/Dev/seven-of-di/"]
        path = ~/Dev/zdraganov/dotfiles/.gitconfig-work
[push]
        default = current
[color]
        ui = auto
[alias]
        aa = add --all
        ca = commit --amend -C HEAD
        caa = commit --amend
        b = "!git for-each-ref --sort='-authordate' --format='%(authordate)%09%(objectname:short)%09%(refname)' refs/heads | sed -e 's-refs/heads/--'"
        ci = commit -v
        co = checkout
        cb = checkout -b
        fo = fetch origin
        pf = push --force-with-lease
        po = push -u origin
        st = status -s
        su = "!git rev-parse --abbrev-ref HEAD | xargs -I '{}' git branch --set-upstream-to=origin/'{}' '{}'"
        lf = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
        la = "!git config -l | grep alias | cut -c 7-"
        ls = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate
        ll = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --numstat
        l  = log --oneline --decorate
        rc = rebase --continue
        au = update-index --assume-unchanged
[core]
        excludesfile = ~/.global_ignore
        autocrlf = input
        editor = nvim
[commit]
        template = ~/.gitmessage
[fetch]
        prune = true
[rebase]
        autosquash = true
[rerere]
        enabled = false
[pull]
        rebase = true
[status]
        submoduleSummary = true
[init]
        defaultBranch = main
[diff]
        tool = vscode
[difftool "vscode"]
        cmd = code --wait --diff $LOCAL $REMOTE
