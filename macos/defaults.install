#!/bin/sh
# macOS specific settings
echo "- Setting up macOS defaults"
mkdir -p "$HOME/Screenshots"
defaults write com.apple.screencapture location "$HOME/Screenshots"
killall SystemUIServer 2>/dev/null || true

# Keyboard: switch input source with Option+` (60 = "Select the previous input source") and
# Ctrl+Option+` (61 = "Select next source in input menu").
# parameters = (ascii, virtual keycode, modifier flags): 96 = '`', 50 = grave key, 524288 = Option, 786432 = Ctrl+Option.
# Written as an XML plist fragment so the numbers are stored as integers — the `(96, 50, ...)` shorthand
# stores strings, which macOS silently ignores.
hotkey() { # id ascii keycode modifiers
  defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add "$1" \
    "<dict><key>enabled</key><true/><key>value</key><dict><key>parameters</key><array><integer>$2</integer><integer>$3</integer><integer>$4</integer></array><key>type</key><string>standard</string></dict></dict>"
}
hotkey 60 96 50 524288
hotkey 61 96 50 786432
/System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings -u 2>/dev/null || true
